# Apache 2.4 / LiteSpeed: static files only; no PHP or rewrite is required.
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType video/mp4 .mp4
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, s-maxage=300, must-revalidate"
  </FilesMatch>
  # Content hashes change whenever a file changes.
  <FilesMatch "\.[a-f0-9]{12}\.(css|js|webp|avif|woff2|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript
  </IfModule>
</IfModule>

# Hostinger Git deployment copies the repository's .git folder into public_html.
<IfModule mod_alias.c>
  RedirectMatch 404 /\.git
</IfModule>
# Project notes and the local cache script are not part of the site.
<FilesMatch "\.(md|mjs)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
